# Copy to .env (gitignored — never commit real credentials) in this same directory. Read fresh
# per call by EnvConfig, keyed to this tool's own name ('portainer-logs') — not shared with any
# other tool's .env.

# Portainer Access Tokens (My account -> Access tokens in the Portainer UI), one per environment
# (hml/prd — see environments.json), sent as the "X-API-Key" header.
PORTAINER_HML_API_KEY=""
PORTAINER_PRD_API_KEY=""
