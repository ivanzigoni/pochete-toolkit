# Copy to .env (gitignored — never commit real credentials) in this same directory. Read fresh
# per call by EnvConfig, keyed to this tool's own name ('safe-curl') — not shared with any other
# tool's .env.

# The auth header value injected into every request for a given authProfile — paste it here
# manually after copying a real login session's cookie/token, never into a curl command or chat.
# Which var name belongs to which authProfile is declared in auth-profiles.json; the tool
# mechanically rejects any curl that already sets its own Cookie/Authorization/profile header, so
# this is the only place that value is allowed to live.
CEM_SAFE_CURL_HML_AUTH_COOKIE="Authorization="
CEM_SAFE_CURL_PRD_AUTH_COOKIE="Authorization="
