# Copy to .env (gitignored — never commit real credentials) in this same directory. Read fresh
# per call by EnvConfig, keyed to this tool's own name ('deepseek-infer') — not shared with any
# other tool's .env.

# API key for the Deepseek chat-completions API (platform.deepseek.com -> API keys).
DEEPSEEK_API_KEY=""

# Optional override for the API base URL (e.g. a proxy/gateway in front of Deepseek). Omit to use
# Deepseek's own https://api.deepseek.com.
DEEPSEEK_BASE_URL=""
