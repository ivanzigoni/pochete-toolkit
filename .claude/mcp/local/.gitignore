.vscode/
.idea/
*.swp
*.swo
*~

# Runtime/scratch
*.tmp
*.temp
*.pid
*.seed
*.pid.lock

# Tool results written via the shared outputFileName mechanism (src/shared/tool-output.ts)
.tool-output/
