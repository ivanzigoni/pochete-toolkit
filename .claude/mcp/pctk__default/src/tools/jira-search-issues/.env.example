# Copy to .env (gitignored — never commit real credentials) in this same directory. Read fresh
# per call by EnvConfig, keyed to this tool's own name ('jira-search-issues') — not shared with
# any other tool's .env.

# Basic-auth credentials for the Jira Cloud REST API: an Atlassian account email plus an API
# token generated at id.atlassian.com (Security -> API tokens). Which env var pair belongs to
# which authProfile — and which Jira site it targets — is declared in auth-profiles.json; add a
# new pair here and a matching entry there for another Jira site/account profile, rather than
# reusing this one.
JIRA_SEARCH_ISSUES_EXAMPLE_PROFILE_EMAIL="you@example.com"
JIRA_SEARCH_ISSUES_EXAMPLE_PROFILE_API_TOKEN="your-atlassian-api-token"
