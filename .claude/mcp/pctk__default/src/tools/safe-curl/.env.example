# Copy to .env (gitignored — never commit real credentials) in this same directory. Read fresh
# per call by EnvConfig, keyed to this tool's own name ('safe-curl') — not shared with any other
# tool's .env.

# The auth header value injected into every request for a given "header"-type authProfile — paste
# it here manually after copying a real login session's cookie/token, never into a curl command or
# chat. Which var name belongs to which authProfile is declared in auth-profiles.json; the tool
# mechanically rejects any curl that already sets its own Cookie/Authorization/profile header, so
# this is the only place that value is allowed to live.
SAFE_CURL_EXAMPLE_PROFILE_AUTH_COOKIE="Authorization="

# A "basic"-type authProfile (see auth-profiles.json) reads a plain user/password pair instead of
# one opaque value — the tool base64-encodes them into the "Authorization: Basic ..." header
# itself, so neither ever needs to be pasted, pre-encoded, into a curl command or chat.
SAFE_CURL_EXAMPLE_BASIC_PROFILE_USER=
SAFE_CURL_EXAMPLE_BASIC_PROFILE_PASSWORD=
