# Copy to .env (gitignored — never commit real credentials) in this same directory. Read fresh
# per call by EnvConfig, keyed to this tool's own name ('aws-safe-cli') — not shared with any
# other tool's .env.

# One access-key/secret-key env var pair per registered auth profile (see auth-profiles.json's
# "accessKeyIdEnvVar"/"secretAccessKeyEnvVar" fields). Use an IAM user/access key scoped by policy
# to the narrowest set of services/operations this profile actually needs, never an admin- or
# root-equivalent key — a profile's blast radius should never exceed what its own IAM policy
# allows. Injected into the aws CLI's child process environment as
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, never passed as a CLI argument.
AWS_SAFE_CLI_EXAMPLE_ACCOUNT_ACCESS_KEY_ID=""
AWS_SAFE_CLI_EXAMPLE_ACCOUNT_SECRET_ACCESS_KEY=""

# Optional: only needed when a profile's "sessionTokenEnvVar" (auth-profiles.json) is set, for
# temporary credentials issued by some external process — this tool itself never calls
# sts assume-role.
# AWS_SAFE_CLI_EXAMPLE_ACCOUNT_SESSION_TOKEN=""

# Optional: absolute path to the aws binary, when it isn't on this MCP server process's PATH.
# Defaults to "aws" resolved via PATH when unset/empty.
AWS_CLI_PATH=""

# Optional: per-call timeout in milliseconds for the spawned aws process. Defaults to 60000
# when unset/empty or not a valid number.
AWS_CLI_TIMEOUT_MS=""
