# Copy to .env (gitignored — never commit real credentials) in this same directory. Read fresh
# per call by EnvConfig, keyed to this tool's own name ('safe-query') — not shared with any other
# tool's .env.

# Engine/host/port/database/user for each registered connection live in config.json's
# "connections" section, keyed by connection name — the tool call only ever takes `connection` +
# `query`, never any of this. Only the password stays out of that file: one var per registered
# connection, named by that connection's own "passwordEnvVar" field.
SAFE_QUERY_EXAMPLE_CONNECTION_PASSWORD="aa"

# Resource limits — fixed server-side on purpose, shared by every connection, never a per-call
# tool argument. See limits.ts for the documented defaults applied when either var is unset.
SAFE_QUERY_TIMEOUT_SECONDS=30
SAFE_QUERY_MAX_ROWS=10000
